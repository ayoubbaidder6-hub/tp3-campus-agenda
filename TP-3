type Evenement = {
  id: string;
  titre: string;
  categorie: string;
  capacite: number;
  inscrits: number;
};

// Liste des événements
const evenements: Evenement[] = [
  {
    id: 'E01',
    titre: 'Atelier React',
    categorie: 'Atelier',
    capacite: 25,
    inscrits: 25,
  },
  {
    id: 'E02',
    titre: 'Conférence IA',
    categorie: 'Conférence',
    capacite: 70,
    inscrits: 52,
  },
  {
    id: 'E03',
    titre: 'Sécurité mobile',
    categorie: 'Atelier',
    capacite: 20,
    inscrits: 17,
  },
  {
    id: 'E04',
    titre: 'Design UI',
    categorie: 'Atelier',
    capacite: 18,
    inscrits: 9,
  },
  {
    id: 'E05',
    titre: 'Forum projets',
    categorie: 'Rencontre',
    capacite: 50,
    inscrits: 49,
  },
  {
    id: 'E06',
    titre: 'Découverte Git',
    categorie: 'Atelier',
    capacite: 24,
    inscrits: 24,
  },
];

// Calcul des places restantes
function placesRestantes(e: Evenement): number {
  return Math.max(0, e.capacite - e.inscrits);
}

// Détermination du statut
function statutEvenement(e: Evenement): string {
  const places = placesRestantes(e);

  if (places === 0) {
    return 'Complet';
  } else if (places <= 3) {
    return 'Presque complet';
  } else {
    return 'Ouvert';
  }
}

// Calcul des statistiques
const totalEvenements = evenements.length;

const evenementsComplets = evenements.filter(
  (e) => placesRestantes(e) === 0
).length;

const evenementsDisponibles = evenements.filter(
  (e) => placesRestantes(e) > 0
).length;

const totalPlaces = evenements.reduce(
  (total, e) => total + placesRestantes(e),
  0
);

const ateliersDisponibles = evenements.filter(
  (e) => e.categorie === 'Atelier' && placesRestantes(e) > 0
);

// Composant BadgeEtat
type BadgeEtatProps = {
  statut: string;
};

function BadgeEtat({ statut }: BadgeEtatProps) {
  let couleur = '#DCFCE7';

  if (statut === 'Complet') {
    couleur = '#FEE2E2';
  } else if (statut === 'Presque complet') {
    couleur = '#FFEDD5';
  }

  return (
    <View style={[styles.badge, { backgroundColor: couleur }]}>
      <Text style={styles.badgeText}>{statut}</Text>
    </View>
  );
}

// Composant CarteEvenement
type CarteEvenementProps = {
  evenement: Evenement;
};

function CarteEvenement({ evenement }: CarteEvenementProps) {
  const places = placesRestantes(evenement);
  const statut = statutEvenement(evenement);

  return (
    <View style={styles.carte}>
      <View style={styles.carteHeader}>
        <Text style={styles.titreCarte}>
          {evenement.titre}
        </Text>

        <BadgeEtat statut={statut} />
      </View>

      <Text style={styles.categorie}>
        {evenement.categorie}
      </Text>

      <Text style={styles.places}>
        {places} places libres
      </Text>

      <Text style={styles.inscriptions}>
        {evenement.inscrits} / {evenement.capacite} inscrits
      </Text>
    </View>
  );
}

// Composant BlocStatistique
type BlocStatistiqueProps = {
  titre: string;
  valeur: number;
};

function BlocStatistique({ titre, valeur }: BlocStatistiqueProps) {
  return (
    <View style={styles.blocStatistique}>
      <Text style={styles.valeurStatistique}>{valeur}</Text>
      <Text style={styles.titreStatistique}>{titre}</Text>
    </View>
  );
}

// Mode d'affichage : 'tous' ou 'ateliers'
const mode: 'tous' | 'ateliers' = 'tous';

const evenementsAffiches =
  mode === 'tous' ? evenements : ateliersDisponibles;

// Application principale
export default function App() {
  return (
    <View style={styles.container}>
      <Text>Open up App.tsx to start working on your app!</Text>
      <StatusBar style="auto" />
      <StatusBar style="dark" />

      <FlatList
        data={evenementsAffiches}
        keyExtractor={(item) => item.id}
        renderItem={({ item }) => (
          <CarteEvenement evenement={item} />
        )}
        contentContainerStyle={styles.liste}
        ListHeaderComponent={
          <View>
            <Text style={styles.header}>CampusAgenda</Text>

            <Text style={styles.sousTitre}>
              Événements du campus
            </Text>

            <View style={styles.statistiques}>
              <BlocStatistique
                titre="Événements au total"
                valeur={totalEvenements}
              />

              <BlocStatistique
                titre="Événements complets"
                valeur={evenementsComplets}
              />

              <BlocStatistique
                titre="Événements avec des places"
                valeur={evenementsDisponibles}
              />

              <BlocStatistique
                titre="Places restantes"
                valeur={totalPlaces}
              />
            </View>

            <Text style={styles.modeTitre}>
              Mode d'affichage : {mode}
            </Text>
          </View>
        }
        ListEmptyComponent={
          <Text style={styles.vide}>
            Aucun événement disponible.
          </Text>
        }
      />
    </View>
  );
}

